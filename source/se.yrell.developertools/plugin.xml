<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.startup">
      <startup class="se.yrell.developertools.ToolsEarlyStartup"/>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="se.yrell.developertools.preferencePage"
            name="Yrell Developer Tools"
            class="se.yrell.developertools.internal.preferences.DeveloperStudioToolsPreferencePage"/>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="se.yrell.developertools.internal.preferences.DeveloperStudioToolsPreferenceInitializer"/>
   </extension>


   <extension point="org.eclipse.ui.views">
      <category
            id="se.yrell.developertools.views"
            name="Yrell Developer Tools"/>
      <view
            id="se.yrell.developertools.views.objectInsight"
            name="Object Insight"
            category="se.yrell.developertools.views"
            class="se.yrell.developertools.inspector.ObjectInsightView"
            restorable="true"
            allowMultiple="false"/>
   </extension>

   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="com.bmc.arsys.studio.ui.eclipse.perspectives.DeveloperPerspectiveFactory">
         <view
               id="se.yrell.developertools.views.objectInsight"
               relative="org.eclipse.ui.views.PropertySheet"
               relationship="stack"
               visible="false"/>
      </perspectiveExtension>
      <perspectiveExtension targetID="com.bmc.arsys.studio.ui.eclipse.perspectives.EditorPerspectiveFactory">
         <view
               id="se.yrell.developertools.views.objectInsight"
               relative="org.eclipse.ui.views.PropertySheet"
               relationship="stack"
               visible="false"/>
      </perspectiveExtension>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <command id="se.yrell.developertools.commands.midTierFlushObject" name="Flush MidTier Object" description="Flush selected form or workflow primary form, in Eclipse Progress"/>
      <command id="se.yrell.developertools.commands.midTierFlush" name="MidTier Cache Flush" description="Flush the cache for the current form or workflow on a configured MidTier"/>
      <command
            id="se.yrell.developertools.commands.removeFromView"
            name="Remove from view"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="se.yrell.developertools.commands.midTierFlushObject" class="se.yrell.developertools.midtier.MidTierFlushObjectHandler"/>
      <handler commandId="se.yrell.developertools.commands.midTierFlush"
               class="se.yrell.developertools.midtier.MidTierFlushHandler"/>
      <handler
            commandId="se.yrell.developertools.commands.removeFromView"
            class="se.yrell.developertools.viewactions.RemoveFromViewHandler"/>
   </extension>

   <extension point="org.eclipse.core.expressions.propertyTesters">
      <propertyTester id="se.yrell.developertools.midTierFlushTester"
                      namespace="se.yrell.developertools" properties="supportsCacheFlush,supportsSelectedFlush,toolbarAvailable"
                      type="java.lang.Object"
                      class="se.yrell.developertools.midtier.MidTierFlushPropertyTester"/>
      <propertyTester
            id="se.yrell.developertools.removeFromViewPropertyTester"
            namespace="se.yrell.developertools"
            properties="canRemoveFromView"
            type="java.lang.Object"
            class="se.yrell.developertools.viewactions.RemoveFromViewPropertyTester"/>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar id="se.yrell.developertools.midTierToolbar">
            <command commandId="se.yrell.developertools.commands.midTierFlush"
                     icon="icons/toilet_16.png" tooltip="Flush MidTier cache for current form / workflow" style="push">
               <visibleWhen checkEnabled="false">
                  <or>
                     <with variable="activeEditor">
                        <test property="se.yrell.developertools.supportsCacheFlush"/>
                     </with>
                     <with variable="selection">
                        <count value="1"/>
                        <iterate ifEmpty="false" operator="and">
                           <test property="se.yrell.developertools.supportsSelectedFlush"/>
                        </iterate>
                     </with>
                     <with variable="activeWorkbenchWindow">
                        <test property="se.yrell.developertools.toolbarAvailable"/>
                     </with>
                  </or>
               </visibleWhen>
            </command>
         </toolbar>
      </menuContribution>
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command commandId="se.yrell.developertools.commands.midTierFlushObject"
                  icon="icons/toilet_16.png" label="Flush MidTier Object" style="push">
            <visibleWhen checkEnabled="false">
               <or>
                  <with variable="selection">
                     <count value="1"/>
                     <iterate ifEmpty="false" operator="and">
                        <test property="se.yrell.developertools.supportsSelectedFlush"/>
                     </iterate>
                  </with>
                  <with variable="activePart">
                     <test property="se.yrell.developertools.supportsCacheFlush"/>
                  </with>
               </or>
            </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="se.yrell.developertools.commands.removeFromView"
               label="Remove from view"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <count value="1"/>
                  <iterate ifEmpty="false" operator="and">
                     <test property="se.yrell.developertools.canRemoveFromView"/>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>

</plugin>
