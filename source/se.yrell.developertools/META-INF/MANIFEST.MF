Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Yrell Developer Tools
Bundle-SymbolicName: se.yrell.developertools;singleton:=true
Bundle-Version: 0.1.33
Bundle-Vendor: Daniel Yrell
Bundle-Activator: se.yrell.developertools.ToolsActivator
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Bundle: org.eclipse.core.runtime,org.eclipse.ui,org.eclipse.jface,org.eclipse.swt,org.eclipse.osgi,org.objectweb.asm,org.objectweb.asm.commons,org.eclipse.ui.views,com.bmc.arsys.studio.model,com.bmc.arsys.studio.api,com.bmc.arsys.studio.commonui,com.bmc.arsys.studio.documenteditor
Import-Package: org.osgi.framework;version="1.8.0",org.osgi.framework.hooks.weaving;version="1.1.0",org.osgi.service.prefs;version="1.1.0"
Export-Package: se.yrell.developertools.runtime
Automatic-Module-Name: se.yrell.developertools
Premain-Class: se.yrell.developertools.fastagent.FastFormsAgent
Agent-Class: se.yrell.developertools.fastagent.FastFormsAgent
Can-Redefine-Classes: false
Can-Retransform-Classes: false
